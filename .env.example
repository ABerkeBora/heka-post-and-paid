# Copy to .env; bind only to localhost. No mainnet configuration is supported.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PORT=3106
# Ignored JSON: {testOnly:true,chainId:84532,project:"post-and-paid",roles:{deployer:{address,privateKey},buyer:{address,privateKey},counterparty:{address,privateKey}}}
# deployer = isolated agent/API payer, buyer = brand, counterparty = creator test beneficiary.
TEST_WALLETS_FILE=.local/test-wallets.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
